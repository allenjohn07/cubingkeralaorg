# build output
dist/
# generated types
.astro/

# dependencies
node_modules/

# local Cloudflare Workers runtime state (Miniflare D1/KV/R2/cache sim, deploy config)
.wrangler/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# environment variables
.env
.env.local
.env.production

